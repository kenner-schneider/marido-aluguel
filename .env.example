# Copie para .env (local) ou configure como Environment Variables no Render.
# Sem nenhuma delas o sistema roda igual, usando arquivo local e notificando no console.

# --- Painel interno (DEFINA ANTES DE PÔR NO AR) ---
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-uma-string-aleatoria-longa

# --- Supabase (cole depois de rodar sql/schema.sql) ---
# Project Settings → API. Use a service_role, NUNCA a anon.
# Esta chave ignora RLS: ela só pode existir no servidor, jamais no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Notificação (Discord) ---
# Servidor → canal #chamados → Editar canal → Integrações → Webhooks → Novo webhook → Copiar URL
DISCORD_WEBHOOK_URL=

# --- Negócio ---
TAXA_PERCENTUAL=20

# Quantos chamados o mesmo IP pode abrir por hora (padrão 5).
# Aumente se clientes de um mesmo prédio/rede reclamarem de bloqueio.
CHAMADOS_POR_HORA=5
