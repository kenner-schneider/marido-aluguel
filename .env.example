# Copie para .env (local) ou configure como Environment Variables no Render.
# Sem nenhuma delas o sistema roda igual, usando arquivo local e notificando no console.

# --- Painel interno (DEFINA ANTES DE PÔR NO AR) ---
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-uma-string-aleatoria-longa

# --- Supabase (cole depois de rodar sql/schema.sql) ---
# Project Settings → API. Use a service_role, NUNCA a anon.
# Esta chave ignora RLS: ela só pode existir no servidor, jamais no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Notificação (Telegram) — canal principal ---
# 1. No Telegram, fale com @BotFather → /newbot → escolha nome e usuário
#    → ele devolve o token (formato 1234567890:AA...).
# 2. Mande qualquer mensagem para o seu bot (ele não pode escrever primeiro).
# 3. Abra https://api.telegram.org/bot<SEU_TOKEN>/getUpdates e copie
#    result[0].message.chat.id — esse é o TELEGRAM_CHAT_ID.
# Para alertar o time todo, crie um grupo, adicione o bot e use o id do grupo
# (começa com -100). O bot precisa ser admin do grupo para postar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notificação (Discord) — canal secundário ---
# Servidor → canal #chamados → Editar canal → Integrações → Webhooks → Novo webhook → Copiar URL
# ATENÇÃO: a Cloudflare bloqueia por IP de saída os datacenters da Render no
# plano free (429 com escopo=cloudflare/ip). O canal fica configurado e volta
# sozinho quando o IP desbloqueia, mas não dá para depender só dele.
DISCORD_WEBHOOK_URL=

# --- Negócio ---
TAXA_PERCENTUAL=20

# Quantos chamados o mesmo IP pode abrir por hora (padrão 5).
# Aumente se clientes de um mesmo prédio/rede reclamarem de bloqueio.
CHAMADOS_POR_HORA=5
